LAMMPS (10 Sep 2025)
KOKKOS mode with Kokkos version 4.6.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
thermo_modify flush yes

# ------ Units -------------------------------------
units metal                                           # eV, ps, Angstrom, bar

# ------ Timer ----------- -------------------------
timer timeout 23:55:00 every 1000
New timer settings: style=normal  mode=nosync  timeout=23:55:00

# ------ Simulation files --------------------------
variable ff_file        index     ./forcefield.lmp   # force field file
variable coord_file     index             coord.lmp   # coordinates file
variable runID          index              ${runID}  # run ID for final restart
variable runID          index              0  
variable rstID          equal            ${runID}-1   # ID of previous  restart
variable rstID          equal            0-1   
variable traj_file      index   trajectory.${runID}   # trajectory file - no extension
variable traj_file      index   trajectory.0   
variable old_restart    index      restart.${rstID}   # previous restart file
variable old_restart    index      restart.-1   
variable new_restart    index      restart.${runID}   # current restart file
variable new_restart    index      restart.0   

# ------ Simulation type ---------------------------
variable single         index                   no    # single point calculation
variable minimisation   index                   no    # energy minimisation
variable relax_cell     index                   no    # energy minimisation with variable cell
variable md             index                   yes    # molecular dynamics
variable plumed         index                   no    # PLUMED: metadynamics, umbrella sampling...
variable fep            index                   no    # free energy perturbation
variable ti             index                   no    # thermodynamic integration
variable multiRun       index                   no    # task farming of runs

# ------ Molecular dynamics variables --------------
variable ens            index                  npt    # ensemble (nve, nph, nvt, npt)
variable timestep       index                0.0005    # simulation timestep (time units)
variable nsteps         index               800000   # number of MD steps
variable nequil         index               100000    # equilibration steps - FEP only

# ------ Thermostat --------------------------------
variable tst            index                 csvr    # thermostat (nh, ber, lang, csvr)
variable temp           index                 300    # starting temperature (K)
variable trel           index                  0.1    # thermostat relaxation time (time units)

# ------ Barostat (NPT runs only) ------------------
variable npttype        index                  iso    # type of NPT (iso, aniso, tri, z...)
variable pres           index                    1    # pressure bar/atm
variable prel           index                    1.   # barostat relaxation time (time units)

# ------ Output ------------------------------------
variable nthermo        index                 1    # thermodynamic data output frequency
variable ntraj          index                 10    # trajectory output frequency - all system
variable trajType       index                  dcd    # trajectory type (dcd, xtc, xyz)

# ------ Random number seeds -----------------------
variable iseed0         index                15973    # Random seed for initial velocities
variable iseed1         index                96248    # Ramdom seed for the stochastic thermostats

# ------ PLUMED variables --------------------------
variable plumed_infile  index         "./plumed.inp"
variable plumed_dir     index            "Walker_"

# ------ FEP variables -----------------------------
variable fep_file       index            "fep.inp"
variable fep_dir        index                 "./"
variable gewald         index                  0.3

# ------ FEP variables -----------------------------
variable multi_dir      index               "run_"

# ------ Multiple Runs/Task Farming ----------------
variable nReplicas          index                     1
if "${nReplicas} <= 1" then "jump SELF end_farming"
jump SELF end_farming

# ------ Atom Style --------------------------------
atom_style atomic

# ------ Period Boundary Conditions ----------------
boundary p p p                                        # 3D Periodic Boundary Conditions
atom_modify   map yes
newton        on
ERROR: Must use 'newton off' with KOKKOS package option 'neigh full' (src/KOKKOS/kokkos.cpp:713)
