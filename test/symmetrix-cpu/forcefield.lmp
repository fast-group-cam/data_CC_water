############################################################
############            Atom Types            ############
############################################################
#@ 2 atom types
variable O equal 1
variable H equal 2

############################################################
############            Atom Masses            ############
############################################################
mass ${O} 15.9994
mass ${H} 1.00784

###########################################################
###########            Atom Charges            ############
###########################################################
############################################################
############        NNP Parameters             #############
############################################################
#
#
#atom_modify   map yes
#newton        on

#read_data   ./init.data
#
#
#pair_style hybrid/overlay mliap unified periodic_r2scan_gen3gen4_stagetwo.model-mliap_lammps.pt mliap unified periodic_r2scan_gen3gen4_stagetwo.model-mliap_lammps.pt 0
#
pair_style    hybrid/overlay symmetrix/mace symmetrix/mace
pair_coeff    * * symmetrix/mace 1 /mnt/ceph/users/noneill/reactive-water/data_CC_water/model/baseline/model/periodic_r2scan_symmetrix_cpu-1-8.json O H
pair_coeff    * * symmetrix/mace 2 /mnt/ceph/users/noneill/reactive-water/data_CC_water/model/delta/model/delta_r2scancc_symmetrix-1-8.json O H
